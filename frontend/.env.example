# Copy to .env.local for local overrides (Vite auto-loads .env* files).
# All variables are build-time (baked into the static bundle at `pnpm build`
# / `vite build` time) -- there is no server-side runtime config for this
# static frontend.

# Base URL of the demo-backend HTTP API.
VITE_BACKEND_URL=http://localhost:8080

# OTLP/HTTP traces endpoint the frontend's span exporter sends to.
# The exporter POSTs to "${VITE_OTLP_ENDPOINT}/v1/traces".
VITE_OTLP_ENDPOINT=http://localhost:4318

# Base URL used to build the "View in Grafana" deep link on the result
# panel. Shape produced today: "${VITE_GRAFANA_BASE_URL}/explore?traceID=<id>"
# -- placeholder until the real Grafana deep-link format is finalized.
VITE_GRAFANA_BASE_URL=http://localhost:3000
